# Copy this file to .env and fill in your Supabase project values.
# Find these under Project Settings > API in the Supabase dashboard.
# The anon key is safe to expose client-side — RLS is the real security boundary.
# NEVER put the service_role key in this file or anywhere in frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
